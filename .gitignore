# Data and derived state — never committed. Rebuild via `make ingest`.
# _state/ holds the ingestion watermark: it is derived, would conflict on
# every merge, and would misrepresent what a fresh clone actually holds.
data/
*.duckdb
*.duckdb.wal
*.parquet

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# Secrets
.env
credentials.json
service-account*.json

# OS / editor
.DS_Store
.vscode/
.idea/
